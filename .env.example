# Pflicht: zufaelliger Schluessel (z. B. `openssl rand -hex 32`). Verschluesselt
# alle Zugangsdaten in der DB - nach dem ersten Start NICHT mehr aendern.
SECRET_KEY=

# Notfall-/Entwicklungs-Login (leer lassen = deaktiviert)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Microsoft Entra SSO (MSAL-Popup). Leer = SSO aus.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Kommagetrennt; leer = jeder Benutzer des Tenants darf rein
ENTRA_ALLOWED_ROLES=SwitchView.Admin
ENTRA_ALLOWED_GROUPS=

SESSION_HOURS=12

# Session-Cookie nur ueber HTTPS: auto (wie die Anfrage kam) oder always
# (empfohlen, wenn SwitchView nur per HTTPS erreichbar ist)
COOKIE_SECURE=auto

# Reverse-Proxy vor SwitchView: dessen IP oder Netz, wie der Container ihn sieht
# (kommagetrennt). Nur er darf X-Forwarded-For/-Proto setzen. Ohne = keinem trauen.
#FORWARDED_ALLOW_IPS=172.18.0.1
