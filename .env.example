# Pflicht: zufaelliger Schluessel (z. B. `openssl rand -hex 32`). Verschluesselt
# alle Zugangsdaten in der DB - nach dem ersten Start NICHT mehr aendern.
SECRET_KEY=

# Notfall-/Entwicklungs-Login (leer lassen = deaktiviert)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Microsoft Entra SSO (MSAL-Popup). Leer = SSO aus.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Kommagetrennt; leer = jeder Benutzer des Tenants darf rein
ENTRA_ALLOWED_ROLES=SwitchView.Admin
ENTRA_ALLOWED_GROUPS=

SESSION_HOURS=12

# Rollen aus den Entra-App-Rollen (Lesen, Aendern, Freigeben, Admin; jede mit den
# Rechten der vorigen). off = jeder SSO-Benutzer hat alle Rechte (wie bisher),
# on = die Rolle kommt aus dem roles-Claim; wer keine zugeordnete App-Rolle hat,
# bekommt Lesen. Der Notfall-Login ist immer Admin. Vor dem Einschalten
# mindestens einer Person SwitchView.Admin zuweisen; die Werte zusaetzlich in
# ENTRA_ALLOWED_ROLES eintragen, wenn das Tor App-Rollen prueft.
ENTRA_ROLE_MAPPING=off
# Die App-Rollen-Werte je Rolle (kommagetrennt, mehrere je Rolle); das sind die Vorgaben
#ENTRA_ROLE_LESEN=SwitchView.Lesen
#ENTRA_ROLE_AENDERN=SwitchView.Aendern
#ENTRA_ROLE_FREIGEBEN=SwitchView.Freigeben
#ENTRA_ROLE_ADMIN=SwitchView.Admin

# Abmeldung nach so vielen Minuten ohne Anfrage (0 = aus)
IDLE_MINUTES=120

# Verlauf (Sichtungen, Ereignisse): so viele Tage aufbewahren (0 = nie loeschen)
HISTORY_DAYS=180

# Oeffentliche Adresse von SwitchView fuer Links in Benachrichtigungen (leer = ohne Link)
#PUBLIC_URL=https://switchview.example.com

# Session-Cookie nur ueber HTTPS: auto (wie die Anfrage kam) oder always
# (empfohlen, wenn SwitchView nur per HTTPS erreichbar ist)
COOKIE_SECURE=auto

# Reverse-Proxy vor SwitchView: dessen IP oder Netz, wie der Container ihn sieht
# (kommagetrennt). Nur er darf X-Forwarded-For/-Proto setzen. Ohne = keinem trauen.
#FORWARDED_ALLOW_IPS=172.18.0.1
